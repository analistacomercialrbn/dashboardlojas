+function driverPayrollRules_(user){
+  requireLogPermission_(user,'formation');
+  if(!['ADMIN','DIRETOR','GERENTE'].includes(user.perfil))throw new Error('O fechamento mensal está disponível para a gestão.');
+  const saved=PropertiesService.getScriptProperties().getProperty('LOG_DRIVER_BONUS_RULES');
+  if(!saved)throw new Error('As regras de premiação dos motoristas precisam ser configuradas.');
+  const rules=JSON.parse(saved),routes={};
+  if(!rules||typeof rules.perOrder!=='number'||!Number.isFinite(rules.perOrder)||rules.perOrder<0||
+     !rules.routes||typeof rules.routes!=='object'||Array.isArray(rules.routes)){
+    throw new Error('Confira as regras de premiação cadastradas.');
+  }
+  for(const [name,value] of Object.entries(rules.routes)){
+    const key=logNorm_(name);
+    if(!key||Object.prototype.hasOwnProperty.call(routes,key)||typeof value!=='number'||!Number.isFinite(value)||value<0){
+      throw new Error('Confira o valor e a classificação de cada rota da premiação.');
+    }
+    routes[key]=value;
+  }
+  return {ok:true,routes,perOrder:rules.perOrder};
+}
